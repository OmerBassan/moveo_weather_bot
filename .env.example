# The only required secret. Anthropic is the sole provider: the Gemini free
# tier caps at 20 requests/day per model, which a single eval run exhausts.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides -- every one of these has a working default in app/config.py.
# WRA_NWS_USER_AGENT=(moveo-weather-risk-agent, omer.m.bassan@gmail.com)
# WRA_HISTORY_START=2021-01-01
# WRA_HISTORY_END=2026-09-20
#
# The threshold for a "disruptive snow day" in MEASUREMENT answers. Default 1.0.
#
# CHANGING IT DOES NOT CHANGE ANY RISK SCORE. The scoring engine reads its own
# threshold from app/scoring/weights.yaml (climatology_thresholds), so setting
# this alone makes a measured day-count disagree with the score built on the
# same concept. Change both, or neither.
# WRA_SNOW_DAY_THRESHOLD_IN=1.0
#
# WRA_HTTP_TIMEOUT=60
